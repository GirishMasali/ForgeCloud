# ==============================================================================
# ForgeCloud Root .gitignore
# Rules & Guardrails: Never commit secrets, credentials, build artifacts, or caches
# ==============================================================================

# --- Environment & Secret Files (Rule 4 & Rule 5) ---
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
secrets/
!kubernetes/secrets/
*.secret

# --- Python & Backend Artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Python Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testing & Coverage
.cache
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/

# --- JavaScript / Node / Frontend Artifacts ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Frontend Build Outputs
frontend/dist/
frontend/dist-ssr/
frontend/build/
*.tsbuildinfo
.eslintcache

# --- Terraform & IaC Artifacts (Rule 4 & Rule 11) ---
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform.tfstate.lock.info
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# --- Docker & Container Local Artifacts ---
.docker/

# --- Operating System & Common IDE Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDEs and Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~
