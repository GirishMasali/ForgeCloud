# ==============================================================================
# ForgeCloud Backend Environment Configuration Template
# ------------------------------------------------------------------------------
# Copy this file to backend/.env for local standalone backend development:
# cp .env.example .env
# Placeholders and development defaults only. Never commit production secrets.
# ==============================================================================

# --- Server & Environment ---
ENVIRONMENT=development
LOG_LEVEL=info
BACKEND_PORT=8000
FORGECLOUD_LOCAL_MODE=true

# --- PostgreSQL Database ---
DATABASE_URL=postgresql://forgecloud_user:forgecloud_password@localhost:5432/forgecloud_db
POSTGRES_USER=forgecloud_user
POSTGRES_PASSWORD=forgecloud_password
POSTGRES_DB=forgecloud_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT Authentication ---
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS Allowed Origins ---
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- AWS Configuration (Placeholders) ---
AWS_REGION=us-east-1
AWS_DEFAULT_OUTPUT=json
AWS_ACCOUNT_ID=000000000000
ECR_REPOSITORY_NAME=forgecloud-apps
EKS_CLUSTER_NAME=forgecloud-dev-eks

# --- Observability ---
PROMETHEUS_METRICS_PATH=/metrics
OTEL_SERVICE_NAME=forgecloud-control-plane
