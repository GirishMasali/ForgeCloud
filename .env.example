# ==============================================================================
# ForgeCloud Unified Environment Configuration Template
# ------------------------------------------------------------------------------
# NOTE: This file contains dummy placeholders and defaults for local development.
# NEVER commit real credentials, production secrets, or cloud keys to version control.
# Copy this file to .env before starting local services: cp .env.example .env
# ==============================================================================

# --- Platform & Runtime Mode ---
ENVIRONMENT=development
LOG_LEVEL=info
# Set to 'true' to use local mock adapters (no active AWS credentials needed)
FORGECLOUD_LOCAL_MODE=true

# --- Server Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Database Configuration (PostgreSQL) ---
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://forgecloud_user:forgecloud_password@localhost:5432/forgecloud_db
POSTGRES_USER=forgecloud_user
POSTGRES_PASSWORD=forgecloud_password
POSTGRES_DB=forgecloud_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT Authentication & Security ---
# Generate a secure key in production (e.g., openssl rand -hex 32)
JWT_SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS Configuration ---
# JSON array of allowed origins for the FastAPI control plane
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- AWS Cloud Configuration (Placeholders - Requires AWS Environment) ---
# DO NOT populate AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY here.
# Use AWS IAM roles, AWS SSO, or local AWS CLI profiles (~/.aws/credentials).
AWS_REGION=us-east-1
AWS_DEFAULT_OUTPUT=json
AWS_ACCOUNT_ID=000000000000
ECR_REPOSITORY_NAME=forgecloud-apps
EKS_CLUSTER_NAME=forgecloud-dev-eks

# --- Observability Configuration ---
PROMETHEUS_METRICS_PATH=/metrics
OTEL_SERVICE_NAME=forgecloud-control-plane
