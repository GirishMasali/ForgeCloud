# ==============================================================================
# ForgeCloud - Example Terraform Variables Configuration (terraform.tfvars.example)
# ==============================================================================

aws_region   = "us-east-1"
environment  = "dev"
project_name = "forgecloud"

# ------------------------------------------------------------------------------
# Networking
# ------------------------------------------------------------------------------
vpc_cidr              = "10.0.0.0/16"
availability_zones    = ["us-east-1a", "us-east-1b"]
public_subnet_cidrs   = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs  = ["10.0.10.0/24", "10.0.20.0/24"]
isolated_subnet_cidrs = ["10.0.100.0/24", "10.0.200.0/24"]

# Cost mitigation: Use a single NAT Gateway in development (ADR-004)
single_nat_gateway    = true
allowed_cidr_blocks   = ["0.0.0.0/0"]

# ------------------------------------------------------------------------------
# IAM / CI/CD
# ------------------------------------------------------------------------------
github_repo = "GirishMasali/ForgeCloud"

# ------------------------------------------------------------------------------
# ECR Repositories
# ------------------------------------------------------------------------------
ecr_repository_names = [
  "forgecloud-apps",
  "sample-backend-service"
]

# ------------------------------------------------------------------------------
# EKS Cluster & Node Group
# ------------------------------------------------------------------------------
kubernetes_version = "1.30"
eks_instance_types = ["t3.medium"]
eks_capacity_type  = "ON_DEMAND"
eks_desired_size   = 2
eks_min_size       = 1
eks_max_size       = 4
eks_disk_size      = 20

# ------------------------------------------------------------------------------
# Tags
# ------------------------------------------------------------------------------
tags = {
  Owner       = "ForgeCloud Platform Team"
  Provisioner = "Terraform"
}
